<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="18dp">

    <!-- Header -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOCUSGUARD"
        android:textColor="@color/metal_blue_light"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOCUS • DISCIPLINE • CONTROL"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Status card -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SESSION STATUS"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No active session"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Accessibility -->

    <Button
        android:id="@+id/enableAccessibilityBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="ENABLE BLOCKING ACCESS"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:backgroundTint="@color/metal_blue_dark"
        android:layout_marginBottom="14dp" />

    <!-- App selector -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APPS TO BLOCK"
        android:textColor="@color/metal_blue_light"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="7dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select applications that should remain unavailable during your focus session."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="9dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface" />

    <!-- Duration -->

    <EditText
        android:id="@+id/durationInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Session duration (minutes)"
        android:inputType="number"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:backgroundTint="@color/metal_blue"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginTop="14dp" />

    <!-- Commitment -->

    <CheckBox
        android:id="@+id/commitmentModeCheckBox"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Commitment Mode — can't stop early"
        android:textColor="@color/text_secondary"
        android:buttonTint="@color/metal_blue_light"
        android:layout_marginTop="5dp" />

    <!-- Start -->

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="START FOCUS SESSION"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.05"
        android:backgroundTint="@color/metal_blue"
        android:layout_marginTop="6dp" />

    <!-- Stop -->

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="STOP SESSION"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="13sp"
        android:backgroundTint="@color/danger"
        android:layout_marginTop="7dp"
        android:visibility="gone" />

</LinearLayout>
